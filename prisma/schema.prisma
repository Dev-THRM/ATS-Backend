// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppPlan {
  ATS
  HRMS
  CRM
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SystemRoleType {
  SUPER_ADMIN
  ADMIN
  MANAGER
  RECRUITER
  EMPLOYEE
  CUSTOM
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  website   String?
  isVerified Boolean @default(false)
  verifiedDomain String?
  sourcingChannels String[] @default(["CAREER_PORTAL", "LINKEDIN", "NAUKRI", "GLASSDOOR", "UNSTOP", "INDEED"])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  roles               Role[]
  subscriptions       Subscription[]
  jobs                Job[]
  candidates          Candidate[]
  applications        Application[]
  stageTransitionLogs StageTransitionLog[]
  interviews          Interview[]
}

model Role {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  description    String?
  type           SystemRoleType @default(CUSTOM)
  permissions    String[]       @default([])
  isSystem       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model User {
  id                  String               @id @default(uuid())
  organizationId      String
  roleId              String
  email               String
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  avatarUrl           String?
  isActive            Boolean              @default(true)
  refreshTokenHash    String?
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role                Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  jobs                Job[]
  stageTransitionLogs StageTransitionLog[]
  interviews          Interview[]

  @@unique([email, organizationId])
  @@index([organizationId])
  @@index([roleId])
  @@index([email])
}

model Subscription {
  id                   String             @id @default(uuid())
  organizationId       String
  activePlans          AppPlan[]          @default([])
  status               SubscriptionStatus @default(TRIALING)
  billingCycle         BillingCycle       @default(MONTHLY)
  startDate            DateTime           @default(now())
  endDate              DateTime?
  trialEndsAt          DateTime?
  maxUsers             Int                @default(10)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  metadata             Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

model Job {
  id              String           @id @default(uuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title           String
  description     String
  department      String?
  location        String?
  employmentType  EmploymentType   @default(FULL_TIME)
  status          JobStatus        @default(DRAFT)
  salaryMin       Decimal?
  salaryMax       Decimal?
  salaryCurrency  String?          @default("INR")
  salaryVisible   Boolean          @default(true)
  experienceMin   Int?
  experienceMax   Int?
  experienceLevel ExperienceLevel?
  createdById     String
  createdBy       User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  pipelineStages  PipelineStage[]
  applications    Application[]
  interviews      Interview[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
}

enum ExperienceLevel {
  ENTRY
  MID
  SENIOR
  LEAD
  EXECUTIVE
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ON_HOLD
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

model PipelineStage {
  id           String        @id @default(uuid())
  jobId        String
  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name         String // "Applied", "Screening", "Interview", "Offer", "Hired", "Rejected"
  order        Int // for sorting stages left-to-right
  applications Application[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([jobId, order])
  @@index([jobId])
}

enum ApplicationStatus {
  ACTIVE
  HIRED
  REJECTED
  WITHDRAWN
}

model Candidate {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  email          String
  phone          String?
  currentCompany String?
  currentTitle   String?
  location       String?
  skills         String[]      @default([])
  resumeUrl      String?
  portfolioUrl   String?
  linkedinUrl    String?
  githubUrl      String?
  source         String?       @default("CAREER_PORTAL") // CAREER_PORTAL, LINKEDIN, REFERRAL, SOURCED, etc.
  tags           String[]      @default([])
  applications   Application[]
  interviews     Interview[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([email, organizationId])
  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, source])
  @@index([email])
  @@index([createdAt])
}

model Application {
  id              String            @id @default(uuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidateId     String
  candidate       Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId           String
  job             Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  currentStageId  String
  currentStage    PipelineStage     @relation(fields: [currentStageId], references: [id], onDelete: Cascade)
  status          ApplicationStatus @default(ACTIVE)
  atsScore        Float? // AI ATS score (0-100)
  source          String?           @default("CAREER_PORTAL") // CAREER_PORTAL, LINKEDIN, NAUKRI, GLASSDOOR, UNSTOP, INDEED, REFERRAL, etc.
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  coverLetter     String?
  rejectionReason String?
  metadata        Json?
  appliedAt       DateTime          @default(now())
  interviews      Interview[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([candidateId, jobId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, appliedAt])
  @@index([candidateId])
  @@index([jobId])
  @@index([jobId, currentStageId])
  @@index([currentStageId])
  @@index([status])
  @@index([source])
  @@index([appliedAt])
}

enum EntityPipelineType {
  APPLICATION
  CRM_DEAL
  CRM_LEAD
}

model StageTransitionLog {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     EntityPipelineType @default(APPLICATION)
  entityId       String // e.g. applicationId or dealId
  fromStageId    String?
  fromStageName  String?
  toStageId      String
  toStageName    String
  performedById  String?
  performedBy    User?              @relation(fields: [performedById], references: [id], onDelete: SetNull)
  reason         String?
  notes          String?
  metadata       Json?
  createdAt      DateTime           @default(now())

  @@index([organizationId])
  @@index([organizationId, entityId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELED
  RESCHEDULED
  NO_SHOW
}

enum InterviewType {
  SCREENING
  TECHNICAL
  BEHAVIORAL
  SYSTEM_DESIGN
  MANAGERIAL
  HR_FINAL
}

model Interview {
  id                     String          @id @default(uuid())
  organizationId         String
  organization           Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId          String
  application            Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidateId            String
  candidate              Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId                  String
  job                    Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  interviewerId          String?
  interviewer            User?           @relation(fields: [interviewerId], references: [id], onDelete: SetNull)

  title                  String          // e.g. "Technical Interview - Backend Architecture"
  type                   InterviewType   @default(SCREENING)
  status                 InterviewStatus @default(SCHEDULED)

  scheduledAt            DateTime        // Start time in UTC
  durationMinutes        Int             @default(45)
  timezone               String?         @default("UTC")

  meetingLink            String?         // Google Meet link (e.g. https://meet.google.com/abc-defg-hij)
  googleCalendarHtmlLink String?         // 1-Click web link to Google Calendar Event

  locationNotes          String?         // Additional joining instructions
  feedbackRating         Int?            // 1 to 5 score
  feedbackNotes          String?         // Interviewer review notes

  reminderSent           Boolean         @default(false)
  reminderSentAt         DateTime?

  metadata               Json?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, scheduledAt])
  @@index([applicationId])
  @@index([candidateId])
  @@index([jobId])
  @@index([interviewerId])
  @@index([scheduledAt])
  @@index([status])
}

