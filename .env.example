DATABASE_URL="postgresql://user:password@localhost:5432/ats_hrms_crm?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_SECRET="your-jwt-secret"
JWT_REFRESH_SECRET="your-jwt-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudflare R2 Storage (Optional - falls back to local storage if empty)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Google Gemini Flash AI (Optional - falls back to deterministic local parser if empty)
GEMINI_API_KEY=""

# Security & CORS (Comma-separated allowed origins for production)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:8081"

# Observability & Crash Reporting (Optional)
SENTRY_DSN=""

# Logging (debug, info, warn, error)
LOG_LEVEL="info"
